{
  "name": "@pulse-compute/fastly-tick",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": "^22.14.0 || ^24.0.0"
  },
  "scripts": {
    "doctor": "pulse doctor",
    "typecheck": "node scripts/generate-worker-fixture.mjs && tsc --noEmit",
    "test": "pulse test",
    "test:native": "node test/native.mjs",
    "test:admission": "node --test test/admission.test.mjs",
    "test:redelivery": "node --test test/redelivery.test.mjs",
    "test:observability": "node --test test/observability.test.mjs",
    "test:registry": "node --test test/registry.test.mjs",
    "test:native-registry": "node test/native-registry.mjs",
    "test:dispatch": "node --test test/dispatch.test.mjs",
    "test:native-dispatch": "node test/native-dispatch.mjs",
    "test:native-dispatch-qualification": "node test/native-dispatch.mjs --qualify",
    "test:native-admission": "node test/native-admission.mjs",
    "test:native-logs": "node test/native.mjs --require-logs",
    "test:trigger": "node --test test/trigger.test.mjs",
    "test:wasm": "node scripts/test-wasm.mjs",
    "dev": "pulse dev",
    "build": "pulse build",
    "build:worker": "node scripts/build-worker.mjs",
    "report": "node scripts/report.mjs",
    "check": "npm run check:package && npm run typecheck && npm run test:trigger && npm run test:worker && npm test",
    "verify:native": "npm run build && npm run build:worker && npm run test:wasm && npm run report",
    "verify": "npm run check && npm run verify:native",
    "check:package": "node scripts/package.mjs check",
    "pack:release": "node scripts/package.mjs pack",
    "test:worker": "node --test test/worker.test.mjs"
  },
  "dependencies": {
    "@pulse-compute/provider-fastly": "1.0.0-beta.7",
    "@pulse-compute/pulse": "1.0.0-beta.7"
  },
  "devDependencies": {
    "@pulse-compute/cli": "1.0.0-beta.7",
    "typescript": "5.9.3"
  },
  "description": "Pulse Fastly Native heartbeat scheduler application kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pulse-compute/fastly-tick.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src/**/*.ts",
    ".pulse/config.ts",
    "tsconfig.json",
    "fastly.toml",
    "scripts/*.mjs",
    "test/*.mjs",
    "test/pulse.harness.ts",
    "fixtures/worker/src/**/*.ts",
    "fixtures/worker/.pulse/config.ts",
    "fixtures/worker/package.json",
    "deploy/*.example.json",
    "docs/*.md",
    "dist/bin/main.wasm",
    "dist/bin/main.wasm.sha256",
    "dist/fastly.toml",
    "dist/pulse-build.json",
    "dist/report.json",
    "dist/report.html",
    "npm-shrinkwrap.json",
    "templates/worker/*.ts"
  ],
  "bin": {
    "fastly-tick": "scripts/worker.mjs"
  }
}
